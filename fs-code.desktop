[Desktop Entry]
Version=2.0
Type=Application
Name=FS-Code
Comment=Modern Python IDE with syntax highlighting
Exec=python3 /path/to/fs-code/app.py
Icon=text-editor
Terminal=false
Categories=Development;IDE;TextEditor;
Keywords=python;ide;editor;development;code;
StartupNotify=true
MimeType=text/x-python;

# Installation instructions:
# 1. Replace /path/to/fs-code/app.py with the actual path
# 2. Copy this file to ~/.local/share/applications/
# 3. Run: chmod +x ~/.local/share/applications/fs-code.desktop
# 4. The application will appear in your application menu
